## ReelForge nginx template. Render with `envsubst '${DOMAIN}' < template > conf.d/reelforge.conf`.
## DOMAIN must be set; the docs/deployment.md file has the exact commands.

server {
    listen 80;
    server_name ${DOMAIN};

    # ACME HTTP-01 challenge.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # ----- SSE: disable buffering so each progress event flushes -----
    location ~ ^/api/v1/jobs/[^/]+/stream$ {
        proxy_pass http://api:8000;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        add_header X-Accel-Buffering no;
    }

    # ----- Media streaming: don't buffer multi-GB bodies -----
    location ~ ^/api/v1/(reels/[^/]+/preview|exports/[^/]+/download|music/[^/]+/audio)$ {
        proxy_pass http://api:8000;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
    }

    # ----- Everything else on /api/* -----
    location /api/ {
        proxy_pass http://api:8000;
        proxy_read_timeout 300s;   # enough for /complete on very large uploads
    }

    # ----- Web UI -----
    location / {
        proxy_pass http://web:3000;
    }
}

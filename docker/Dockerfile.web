# syntax=docker/dockerfile:1.7

# ---- Stage 1: deps + build ---------------------------------------------------
FROM node:20.18-alpine AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.12.2 --activate

# NEXT_PUBLIC_* values must be present at build time — they're inlined into the
# client bundle. Pass via `build.args` in compose.
ARG NEXT_PUBLIC_API_URL=http://localhost:8001
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Copy manifest first for better layer caching. Lockfile is optional on first build.
COPY apps/web/package.json ./
COPY apps/web/pnpm-lock.yaml* ./
RUN if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi

COPY apps/web/ ./
RUN pnpm build

# ---- Stage 2: runtime --------------------------------------------------------
FROM node:20.18-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000
# node:20-alpine ships a non-root `node` user at uid/gid 1000 — use it.
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public

USER node
EXPOSE 3000
CMD ["node", "server.js"]

ANTHROPIC_API_KEY=sk-ant-...
REELFORGE_ENV=development
MAX_UPLOAD_GB=5

# --- Social publishing (optional) -------------------------------------------
# Each platform needs an OAuth app YOU create (all free). Setup guides:
# docs/publishing.md. Leave any platform empty to disable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Host-visible URLs used in the OAuth redirect flow (defaults fit local dev).
REELFORGE_PUBLIC_API_BASE=http://localhost:8001
REELFORGE_WEB_BASE=http://localhost:3000
# Instagram only: public HTTPS base reaching this API (Meta fetches the video).
#
# Preferred — a named tunnel on a domain you own. Set up once, then this value
# never changes again:
#   cloudflared tunnel login && ./scripts/named-tunnel-setup.sh
#   docker compose -f compose.yml -f compose.named-tunnel.yml up -d
#
# Fallback — a quick tunnel, which invents a new hostname on every restart and
# has to be re-pasted here each time:
#   docker compose --profile tunnel up -d tunnel
#   docker compose logs tunnel | grep trycloudflare
REELFORGE_PUBLIC_MEDIA_BASE=

# --- Agent access (Muse over MCP) -------------------------------------------
# A folder ReelForge watches for footage; point it at an iCloud/Dropbox
# folder that syncs from your phone. Must also be mounted into the api
# container. Empty disables the scanner.
REELFORGE_WATCH_DIR=
# Where finished clips are copied when delivery includes "folder".
REELFORGE_DELIVERY_DIR=
# Default delivery when an agent doesn't say: links | folder | email (commas).
REELFORGE_DELIVERY_DEFAULT=links
# Email delivery. SMTP_FROM/SMTP_TO are required for it to work at all.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

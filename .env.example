ANTHROPIC_API_KEY=sk-ant-...
REELFORGE_ENV=development
MAX_UPLOAD_GB=5

# --- Social publishing (optional) -------------------------------------------
# YouTube publishing needs an OAuth client from YOUR Google Cloud project.
# Setup guide: docs/publishing.md. Leave empty to disable the feature.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Host-visible URLs used in the OAuth redirect flow (defaults fit local dev).
REELFORGE_PUBLIC_API_BASE=http://localhost:8001
REELFORGE_WEB_BASE=http://localhost:3000
